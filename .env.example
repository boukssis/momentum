# Public site URL used for canonical links, sitemap, and Open Graph.
# On Vercel this falls back to the deployment URL when unset.
NEXT_PUBLIC_SITE_URL=

# Email delivery is optional. All three must be set or the contact form
# will say so and will not pretend a message was sent.
# CONTACT_FROM_EMAIL must be a sender verified with Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
